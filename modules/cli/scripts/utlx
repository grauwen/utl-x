#!/bin/bash
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LIB_DIR="$SCRIPT_DIR/../build/libs"

# Resolve the most recently built cli-*.jar instead of pinning a version -- a
# pinned version silently keeps running the previous release's jar after a bump.
JAR="$(ls -t "$LIB_DIR"/cli-*.jar 2>/dev/null | head -n 1)"

if [ -z "$JAR" ]; then
    echo "Error: no cli JAR found in $LIB_DIR"
    echo "Run './gradlew :modules:cli:jar' first"
    exit 1
fi

exec java -jar "$JAR" "$@"