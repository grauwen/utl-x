#!/bin/bash
# UTL-X CLI wrapper script

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/modules/cli/build/libs"

# Resolve the most recently built cli-*.jar instead of pinning a version. A pinned
# version silently keeps running the previous release's jar after a version bump --
# that cost real debugging time at 1.4.0, where the stale jar reported a freshly
# registered function as missing.
CLI_JAR="$(ls -t "$LIB_DIR"/cli-*.jar 2>/dev/null | head -n 1)"

if [[ -z "$CLI_JAR" ]]; then
    echo "Error: no CLI JAR found in $LIB_DIR" >&2
    echo "Build it first: ./gradlew :modules:cli:jar" >&2
    exit 1
fi

exec java -jar "$CLI_JAR" "$@"
